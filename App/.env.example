# Copy to .env and fill in. Create the OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application)
# with authorized redirect URI: http://localhost:5001/auth/callback
SECRET_KEY=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key for Atlas: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
